{
  "name": "fullstack-auth-app",
  "version": "1.0.0",
  "description": "Template fullstack React TypeScript + NestJS avec authentification",
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "pnpm --filter client run build",
    "build:server": "pnpm --filter server run build",
    "start": "concurrently \"pnpm run start:server\" \"pnpm run start:client\"",
    "start:client": "pnpm --filter client run start",
    "start:server": "pnpm --filter server run start:dev",
    "start:prod": "pnpm --filter server run start:prod",
    "test": "pnpm --filter server run test",
    "test:e2e": "pnpm --filter server run test:e2e",
    "dev": "concurrently \"pnpm run start:server\" \"pnpm run start:client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.14.1",
      "validator": "^13.15.23"
    },
    "onlyBuiltDependencies": [
      "sqlite3",
      "@parcel/watcher",
      "core-js",
      "core-js-pure",
      "esbuild",
      "sharp"
    ]
  }
}
