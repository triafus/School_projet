{
  "name": "fullstack-auth-app",
  "version": "1.0.0",
  "description": "Template fullstack React TypeScript + NestJS avec authentification",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && pnpm run build",
    "build:server": "cd server && pnpm run build",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "start:client": "cd client && pnpm start",
    "start:server": "cd server && pnpm run start:dev",
    "start:prod": "cd server && pnpm run start:prod",
    "install:all": "pnpm install && cd client && pnpm install && cd ../server && pnpm install",
    "dev": "concurrently \"pnpm run start:server\" \"pnpm run start:client\""
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "pnpm": {
    "overrides": {
      "body-parser": "^1.20.6",
      "multer": ">=2.4.0",
      "react-router": "^7.18.0",
      "qs": ">=6.16.0",
      "@tootallnate/once": ">=2.0.1",
      "axios": ">=1.12.0",
      "ws": ">=8.18.1",
      "tar": ">=7.4.0",
      "path-to-regexp": ">=8.2.0",
      "uuid": "9",
      "file-type": ">=21.3.2",
      "@nestjs/config": "^4.0.2"
    }
  }
}
