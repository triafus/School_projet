#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🏃 Démarrage de la routine pre-push (Lint, Audit, Build, Tests)..."

# Client
echo "👉 Vérification du Client..."
cd client
pnpm install --no-frozen-lockfile
pnpm run lint
pnpm audit --prod --audit-level=high
pnpm run build
cd ..

# Server
echo "👉 Vérification du Server..."
cd server
pnpm install --no-frozen-lockfile
pnpm run lint
pnpm audit --prod --audit-level=high
pnpm run build

echo "✅ Routine pre-push terminée avec succès !"
