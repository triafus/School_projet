# Environnement d'exécution (development, production, test)
NODE_ENV=development

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=school_projet
DB_SSL=false

# Alternative: Utiliser SQLite pour le développement ou les tests
USE_SQLITE=false

# Authentification
JWT_SECRET=super_secret_jwt_key_pour_le_developpement

# URL du frontend pour CORS
VITE_FRONT_URL=http://localhost:3000

# Port du serveur backend
PORT=3001

# Supabase (pour la gestion des images ou base de données distante)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_cle_secrete_supabase
